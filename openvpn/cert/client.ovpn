# 此选项可以代替tls-auth尾部的1，1代表客户端
key-direction 1

# 使用用户名密码登录(不需要cert和key，但是需要ca和tls-auth(如果开启的话))
;auth-user-pass

# 不自动登录
;auth-nocache

# 其它
resolv-retry infinite
nobind
persist-tun
remote-cert-tls server
verb 3
